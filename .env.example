APP_NAME="PKM Telegram Bot"
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://pkm:pkm@postgres:5432/pkm
TEST_DATABASE_URL=postgresql+asyncpg://pkm:pkm@postgres:5432/pkm_test
POSTGRES_USER=pkm
POSTGRES_PASSWORD=pkm
POSTGRES_DB=pkm
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
# JSON array of numeric Telegram sender user IDs; required when polling is enabled.
TELEGRAM_ALLOWED_USER_IDS=[]
KNOWLEDGE_BASE_PATH=knowledge-base
REDIS_URL=redis://redis:6379/0
TASK_DISPATCHER_ENABLED=false

# Required by later milestones. Leave empty for now.
OPENAI_API_KEY=
